# --- بهینه‌سازی تصویر بعد از آپلود Filament (WebP + resize) ---
# IMAGE_OPTIMIZER_ENABLED=true
# IMAGE_OPTIMIZER_DRIVER=gd

# --- ذخیره‌سازی عمومی (تصاویر محصول، دسته، اسلایدر و ...) ---
# پیش‌فرض لوکال: storage/app/public
# FILESYSTEM_PUBLIC_URL=https://example.com/data   # اختیاری؛ مسیر /data در routes/web.php سرو می‌شود

# --- Liara / Runflare (دیسک پایدار mount شده روی /data — چند پاد) ---
# در پنل: دیسک را به مسیر /data وصل کنید، سپس یک‌بار بعد از deploy:
#   php artisan shop:sync-public-storage && php artisan shop:fix-storage-permissions && php artisan shop:import-existing-media
# FILESYSTEM_PUBLIC_ROOT=/data
# FILESYSTEM_PUBLIC_URL=https://sarayechini.ir/data
# LIVEWIRE_TEMP_DISK=livewire-tmp
# LIVEWIRE_TEMP_ROOT=/data
# با FILESYSTEM_PUBLIC_ROOT=/data لاگ و بک‌آپ DB به‌صورت خودکار روی همان دیسک می‌روند:
#   /data/logs و /data/database-backups و /data/files-backups
# (نیازی به دیسک جدا برای /storage/logs نیست — آن mount اغلب با مسیر واقعی Laravel یکی نیست.)
# SHOP_LOGS_DIRECTORY=/data/logs
# LOG_STACK=daily
# PAYMENT_LOG_LIST_DAYS=30
# PAYMENT_LOG_ARCHIVE_AFTER_DAYS=30
# LOG_PAYMENTS_DAYS=45
# LARAVEL_LOG_LIST_DAYS=20
# LOG_DAILY_DAYS=14
# DB_BACKUP_DIRECTORY=/data/database-backups
# FILES_BACKUP_DIRECTORY=/data/files-backups
# FILES_BACKUP_KEEP=1
# FILES_BACKUP_SCHEDULE_TIME=19:00
